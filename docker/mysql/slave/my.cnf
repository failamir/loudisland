[mysqld]
# ─────────────────────────────────────────────
# MySQL SLAVE Configuration
# Role: Read replica (all SELECT queries)
# ─────────────────────────────────────────────

server-id              = 2
relay-log              = relay-bin
relay-log-index        = relay-bin.index
log-slave-updates      = 1
read-only              = 1          # Slave is read-only
super-read-only        = 0          # Allow root for admin tasks

# Point to master (override via setup.sh)
# master-host    = mysql-master
# master-user    = replicator
# master-password = replicator_secret_2024

# Performance
innodb_buffer_pool_size = 512M
innodb_log_file_size    = 128M
innodb_flush_log_at_trx_commit = 2  # Slightly relaxed for replica
innodb_flush_method    = O_DIRECT

# General
character-set-server   = utf8mb4
collation-server       = utf8mb4_unicode_ci
max_connections        = 500
wait_timeout           = 600
