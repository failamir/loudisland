APP_NAME=Loudisland
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ─────────────────────────────────────────────
# DATABASE — MySQL Master/Slave Cluster
# Write → master, Read → slave (for scalability)
# ─────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql-master
DB_PORT=3306
DB_DATABASE=loudisland
DB_USERNAME=loudisland
DB_PASSWORD=root
DB_ROOT_PASSWORD=root

# Read/Write Splitting (Docker container hostnames)
DB_WRITE_HOST=mysql-master
DB_READ_HOST=mysql-slave

# ─────────────────────────────────────────────
# REDIS — Cache + Session + Pub/Sub Chat Channel
# DB 0 = default, DB 1 = cache, DB 2 = session, DB 3 = pub/sub
# ─────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_PUBSUB_DB=3

# ─────────────────────────────────────────────
# CACHE & SESSION — Redis (shared across all containers)
# ─────────────────────────────────────────────
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_CONNECTION=session

# ─────────────────────────────────────────────
# BROADCASTING — Redis Pub/Sub CHAT CHANNEL
# ─────────────────────────────────────────────
BROADCAST_DRIVER=redis

# ─────────────────────────────────────────────
# QUEUE — RabbitMQ Asynchronous Event Tasks
# ─────────────────────────────────────────────
QUEUE_CONNECTION=rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=root
RABBITMQ_VHOST=loudisland
RABBITMQ_QUEUE=default

# ─────────────────────────────────────────────
# FILESYSTEM
# ─────────────────────────────────────────────
FILESYSTEM_DISK=local

# ─────────────────────────────────────────────
# MAIL
# ─────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@loudisland.id"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────
# AWS (optional)
# ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─────────────────────────────────────────────
# PUSHER (optional — using Redis instead)
# ─────────────────────────────────────────────
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
